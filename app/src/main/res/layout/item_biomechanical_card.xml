<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121824">

    <!-- Swing Sequencing Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SWING SEQUENCING"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#8A99AD"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvSequencingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/ui_optimal_green" />

    <TextView
        android:id="@+id/tvSequencingDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="#C5D1E0" />

    <ProgressBar
        android:id="@+id/progressSequencing"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progressDrawable="@drawable/ic_dashboard" />

    <!-- Power Pattern Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="POWER PATTERN"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#8A99AD"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvPowerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/ui_optimal_green" />

    <TextView
        android:id="@+id/tvPowerDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="12sp"
        android:textColor="#C5D1E0" />

    <ProgressBar
        android:id="@+id/progressPower"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100" />

    <!-- Coaching Insight Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="COACHING INSIGHT"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#8A99AD"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/tvCoachingInsight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="#E2E8F0" />

</LinearLayout>
